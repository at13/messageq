{
  "name": "messageq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "load:test": "tsc -p tsconfig.load.json && node dist-tests/load-test.js",
    "dev": "npm run build && node --env-file=.env dist/main.js",
    "migrate": "npm run build && node dist/migrate.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit.test.ts tests/load-test.test.ts",
    "test:integration": "vitest run tests/integration.test.ts tests/viewer.integration.test.ts"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.2.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "typescript": "latest",
    "vitest": "^3.2.4"
  }
}
